
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_tr.h"

#define LDEF 0
#define LSYM 1
#define LNAV 2
#define LFUN 3
#define LMOD 4


/ {
  combos {
    compatible = "zmk,combos";
    combo_esc {
      timeout-ms = <50>;
      key-positions = <49 50>;
      bindings = <&kp ESC>;
    };
    combo_del {
      timeout-ms = <50>;
      key-positions = <55 56>;
      bindings = <&kp DEL>;
    };
    combo_scrolup {
      timeout-ms = <50>;
      key-positions = <41 42>;
      bindings = <&msc SCRL_UP>;
      layers = <LNAV>;
    };
    combo_scroldown {
      timeout-ms = <50>;
      key-positions = <55 56>;
      bindings = <&msc SCRL_DOWN>;
      layers = <LNAV>;
    };
  };

  behaviors {
    #include "macros.dtsi"
    #include "version.dtsi"
    #ifndef VERSION_MACRO
    macro_ver: macro_ver {
      compatible = "zmk,behavior-macro";
      label = "macro_version";
      #binding-cells = <0>;
      bindings = <&kp RET>;
    };
    #endif

    macro_combo: macro_combo {
        compatible = "zmk,behavior-macro";
        label = "macro_combo";
        #binding-cells = <0>;
        bindings = <&kp N2>, <&kp N0>, <&kp N2>, <&kp N4>, <&kp N0>, <&kp N2>, <&kp N1>, <&kp N8>, <&kp MINUS>, <&kp V>, <&kp N1>, <&kp DOT>, <&kp N0>, <&kp MINUS>, <&kp A>, <&kp N7>, <&kp C>, <&kp A>, <&kp N1>, <&kp N8>, <&kp N3>, <&kp RET>;
    };

    hm: homerow_mods {
        compatible = "zmk,behavior-hold-tap";
        label = "HOMEROW_MODS";
        #binding-cells = <2>;
        tapping-term-ms = <220>;
        quick_tap_ms = <200>;
        flavor = "balanced";
        bindings = <&kp>, <&kp>;
    };

    // using &hlt instead of &lt. It enables quick tap
    hlt: homerow_layers {
        compatible = "zmk,behavior-hold-tap";
        label = "HOMEROW_LAYERS";
        #binding-cells = <2>;
        tapping-term-ms = <220>;
        quick_tap_ms = <200>;
        flavor = "balanced";
        bindings = <&mo>, <&kp>;
    };
  };

    macros {
        m_tr_g: m_tr_g {
            label = "ZM_m_tr_g";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp SPACE>
                , <&macro_release &kp LALT>
                , <&macro_tap &kp LEFT_BRACKET>
                , <&macro_press &kp LALT>
                , <&macro_tap &kp SPACE>
                , <&macro_release &kp LALT>
                ;
        };

    };

    keymap {
        compatible = "zmk,keymap";


        default_layer {
            display-name = "Base";
            bindings = <
 &kp X      &kp N1      &kp N2        &kp N3               &kp N4                &kp N5         &none                                                                                               &mo LMOD    &kp N6        &kp N7         &kp N8       &kp N9        &kp N0           &kp X
 &kp X      &kp Q       &kp W         &kp E                &kp R                 &kp T          &none                                                                                               &none       &kp Y         &kp U          &kp I        &kp O         &kp P            &kp X
 &kp X      &hm LALT A  &hm LCTRL S   &hm LSHIFT D         &hm LGUI F            &hm LALT G     &caps_word &kp X         &to LTRDEF                                 &kp LGUI         &kp X          &caps_word  &hm RALT H    &hm RGUI J     &hm RSHIFT K &hm RCTRL L   &hm RALT SEMI    &kp X
 &kp X      &kp Z       &kp X         &kp C                &kp V                 &kp B                                   &kp HOME                                   &kp PG_UP                                   &kp N         &kp M          &kp COMMA    &kp DOT       &kp FSLH         &kp X
 &mo X      &kp GRAVE   &kp CAPS      &kp LEFT             &kp RIGHT                       &hlt LSYM SPACE &hlt LFUN TAB &kp LS(LG(LBKT))                           &kp LS(LG(RBKT)) &kp ENTER      &hlt LNAV BSPC            &kp LBKT       &kp RBKT     &kp EQUAL     &kp MINUS        &mo LNAV
            >;
        };


        layer_symbol {
            display-name = "Symbols";
            bindings = <
 &kp X      &kp N1      &kp N2        &kp N3               &kp N4                &kp N5         &trans                                                                                              &mo LMOD    &kp N6        &kp KP_NUM     &kp KP_EQUAL  &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp X
 &kp X      &kp GRAVE   &kp AT        &kp LEFT_BRACE       &kp RIGHT_BRACE       &kp PLUS       &none                                                                                               &none       &kp PIPE      &kp PERCENT    &caps_word    &kp SQT          &kp BSLH         &kp X
 &kp X      &kp CARET   &kp DOLLAR    &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp ASTERISK   &none      &trans        &kp LGUI                                   &kp LGUI         &trans         &none       &kp AMPERSAND &kp EQUAL      &kp EXCL      &kp DQT          &kp COLON        &kp X
 &kp X      &kp PERCENT &kp TILDE     &kp LEFT_BRACKET     &kp RIGHT_BRACKET     &kp MINUS                               &kp HOME                                   &kp PG_UP                                   &kp HASH      &kp UNDERSCORE &kp LESS_THAN &kp GREATER_THAN &kp FSLH         &kp X
 &mo X      &kp GRAVE   &kp CAPS      &kp LEFT             &kp RIGHT                            &none      &kp TAB       &trans                                     &trans           &trans         &trans                    &kp N0         &kp DOT       &kp KP_DOT       &kp RBKT         &mo LNAV
            >;
        };

        layer_navigation {
            display-name = "Nav";
            bindings = <
 &kp F1     &kp F2      &kp F3        &kp F4               &kp F5                &kp F6         &none                                                                                               &mo LMOD    &kp F7          &kp F8       &kp F9         &kp F10          &kp F11          &kp F12
 &trans     &trans      &kp RC(UP)    &kp RC(LEFT)         &kp RC(RIGHT)         &kp PLUS       &none                                                                                               &none       &kp HOME        &kp PG_DN    &kp PG_UP      &kp END          &trans           &trans
 &trans     &trans      &kp RC(DOWN)  &kp LS(LG(LBKT))     &kp LS(LG(RBKT))      &kp ASTERISK   &none      &trans        &trans                                     &trans           &trans         &none       &kp LEFT        &kp DOWN     &kp UP         &kp RIGHT        &mkp RCLK        &trans
 &trans     &trans      &trans        &kp LS(LG(GRAVE))    &kp LG(GRAVE)         &kp MINUS                               &trans                                     &trans                                      &mmv MOVE_LEFT  &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT  &mkp LCLK        &trans
 &trans     &trans      &trans        &trans               &trans                               &to LNAV   &trans        &trans                                     &trans           &trans         &trans                      &mkp LCLK    &mkp RCLK      &trans           &trans           &trans
            >;
        };

        layer_function {
            display-name = "Fun";
            bindings = <
 &kp F1     &kp F2      &kp F3        &kp F4               &kp F5                &kp F6         &none                                                                                               &mo LMOD    &trans        &kp F10        &kp F11      &kp F12       &trans           &trans
 &trans     &trans      &kp RC(UP)    &kp RC(LEFT)         &kp RC(RIGHT)         &kp PLUS       &none                                                                                               &none       &trans        &kp F7         &kp F8       &kp F9        &trans           &trans
 &trans     &trans      &kp RC(DOWN)  &kp LS(LG(LBKT))     &kp LS(LG(RBKT))      &kp ASTERISK   &none      &trans        &caps_word                                 &trans           &trans         &none       &trans        &kp F4         &kp F5       &kp F6        &trans           &trans
 &trans     &trans      &trans        &kp LS(LG(GRAVE))    &kp LG(GRAVE)         &kp MINUS                               &trans                                     &trans                                      &trans        &kp F1         &kp F2       &kp F3        &trans           &trans
 &trans     &trans      &trans        &trans               &trans                               &to LFUN   &trans        &trans                                     &trans           &trans         &trans                    &trans         &trans       &trans        &trans           &trans
            >;
        };

        layer_mod {
            display-name = "Mod";
            bindings = <
 &none     &bt BT_SEL 0 &bt BT_SEL 1  &bt BT_SEL 2         &bt BT_SEL 3          &bt BT_SEL 4   &none                                                                                               &trans      &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2 &bt BT_SEL 3  &bt BT_SEL 4     &none
 &none      &none       &none         &none                &none                 &none          &bootloader                                                                                         &bootloader &none         &none          &none        &none         &none            &none
 &none      &none       &none         &none                &none                 &none       &rgb_ug RGB_MEFS_CMD 5 &none &none                                     &bt BT_CLR       &none     &rgb_ug RGB_MEFS_CMD 5 &none   &none          &none        &none         &none            &none
 &none      &none       &none         &none                &macro_ver            &none                                   &none                                      &none                                       &none         &none          &none        &none         &none            &none
 &none      &none       &none         &bl BL_INC           &bl BL_DEC                        &rgb_ug RGB_TOG &bl BL_TOG  &none                                      &none            &bl BL_TOG     &rgb_ug RGB_TOG           &bl BL_INC     &bl BL_DEC   &none         &none            &none
            >;
        };
    };
};
